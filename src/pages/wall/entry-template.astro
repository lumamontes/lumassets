---
import Base from '../../layouts/Base.astro';
import { wallEntrySlots as entry } from '../../lib/wall-entry.ts';
---

<Base title={entry.title} description={entry.description} canonicalUrl={entry.canonical}
  previewImage={{ url: entry.image, width: entry.width, height: entry.height, alt: entry.title }}>
  <article class="entry">
    <a class="back mono" href="/wall/">← Wall</a>
    <header>
      <h1>{entry.title}</h1>
      <p class="muted">{entry.byline}</p>
    </header>
    <img src={entry.image} width={entry.width} height={entry.height} alt={entry.title} />
    <div class="actions">
      <button type="button" class="btn primary" id="share-entry">Share</button>
      <a class="btn" href={entry.remix}>Remix</a>
    </div>
    <p class="muted" id="share-status" role="status"></p>
    <input id="share-link" aria-label="Share link" type="url" readonly hidden />
  </article>
</Base>

<style>
  .entry { max-width: 58rem; margin: auto; padding: 1.25rem; }
  .back { font-size: 0.8rem; }
  header { margin: 1rem 0; }
  h1 { margin: 0; overflow-wrap: anywhere; }
  header p { margin: 0.25rem 0 0; }
  header p:empty, #share-status:empty { display: none; }
  img { display: block; max-width: 100%; height: auto; border: 1px solid var(--line); background: repeating-conic-gradient(#e8e8e8 0 25%, #fff 0 50%) 0 0 / 14px 14px; }
  .actions { display: flex; gap: 0.5rem; margin-top: 1rem; }
  #share-link { width: 100%; }
</style>

<script>
  import { shareWallEntry } from '../../scripts/wall-share';
  const canonical = document.querySelector<HTMLLinkElement>('link[rel="canonical"]')!;
  const title = document.querySelector('h1')!.textContent!;
  document.getElementById('share-entry')!.addEventListener('click', () => {
    void shareWallEntry(canonical.href, title, document.getElementById('share-status')!, document.querySelector<HTMLInputElement>('#share-link')!);
  });
</script>
